# Copy to deploy/.env and replace every placeholder. NEVER commit real values.
ALGORE_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ALGORE_DASHBOARD_API_KEY=REPLACE_WITH_A_RANDOM_API_KEY
ALGORE_CORS_ORIGINS=https://your-dashboard.example
# Optional alias (accepted when ALGORE_CORS_ORIGINS is unset):
# ALLOWED_ORIGINS=https://your-dashboard.example
ALGORE_DB_PATH=/data/algore.db
ALGORE_HOST=0.0.0.0
ALGORE_PORT=8000
