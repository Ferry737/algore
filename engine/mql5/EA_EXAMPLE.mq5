#property version   "1.00"
#property description "AlgoRE generated strategy EA — clean-room; verify in MetaEditor"
// Strategy: ExampleEA   genome id: example   magic: 900001
// Generated by app/mql5_exporter.py. Term variables follow <f><n>k<k>_s<shift>.
// The engine NEVER touches open positions: g_multiplier / g_paused affect the NEXT ENTRY ONLY.

input long   InpMagic          = 900001;       // bot id / magic
input double InpRiskPercent    = 0.66;    // target risk % per trade
input string InpApiBase        = "https://YOUR-API-HOST";
input string InpBotToken       = "<bot JWT>";
input int    InpPollSeconds    = 60;            // INC-12: risk changes need no restart
input double InpDailyLossPct   = 4.0;           // CAM-13
input bool   InpSymbolLock     = true;          // POR-04
input double InpMaxAggRiskPct  = 5.0;           // POR-04
input int    InpSlippagePoints = 5;
input int    InpRsiPeriod      = 14;
input int    InpAtrPeriod      = 21;
input int    InpMaPeriod       = 20;
input int    InpBandsPeriod    = 37;
input int    InpAdxPeriod      = 14;

int      hRSI = INVALID_HANDLE, hATR = INVALID_HANDLE, hMA = INVALID_HANDLE;
int      hBands = INVALID_HANDLE, hADX = INVALID_HANDLE;
double   g_multiplier = 0.25;
bool     g_paused = false;
bool     g_api_ok = false;
datetime g_lastPoll = 0;

int OnInit()
{
   hRSI   = iRSI(_Symbol, PERIOD_CURRENT, InpRsiPeriod, PRICE_CLOSE);
   hATR   = iATR(_Symbol, PERIOD_CURRENT, InpAtrPeriod);
   hMA    = iMA(_Symbol, PERIOD_CURRENT, InpMaPeriod, 0, MODE_EMA, PRICE_CLOSE);
   hBands = iBands(_Symbol, PERIOD_CURRENT, InpBandsPeriod, 0, 2.0, PRICE_CLOSE);
   hADX   = iADX(_Symbol, PERIOD_CURRENT, InpAdxPeriod);
   if(hRSI == INVALID_HANDLE || hATR == INVALID_HANDLE || hMA == INVALID_HANDLE ||
      hBands == INVALID_HANDLE || hADX == INVALID_HANDLE)
      return(INIT_FAILED);
   EventSetTimer(InpPollSeconds);
   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason)
{
   EventKillTimer();
   if(hRSI != INVALID_HANDLE) IndicatorRelease(hRSI);
   if(hATR != INVALID_HANDLE) IndicatorRelease(hATR);
   if(hMA != INVALID_HANDLE) IndicatorRelease(hMA);
   if(hBands != INVALID_HANDLE) IndicatorRelease(hBands);
   if(hADX != INVALID_HANDLE) IndicatorRelease(hADX);
}

bool NewBar()
{
   static datetime last_bar = 0;
   datetime t = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(t == last_bar) return(false);
   last_bar = t;
   return(true);
}

// Read one rendered term variable from the matching indicator buffer / price series.
// The full generator emits this switch from the genome AST; kept deterministic here.
double V(const string name)
{
   int shift = 1;
   int at = StringFind(name, "_s");
   if(at > 0) shift = (int)StringToInteger(StringSubstr(name, at + 2));
   if(StringFind(name, "close") == 0) return(iClose(_Symbol, PERIOD_CURRENT, shift));
   if(StringFind(name, "open") == 0)  return(iOpen(_Symbol, PERIOD_CURRENT, shift));
   if(StringFind(name, "high") == 0)  return(iHigh(_Symbol, PERIOD_CURRENT, shift));
   if(StringFind(name, "low") == 0)   return(iLow(_Symbol, PERIOD_CURRENT, shift));
   if(StringFind(name, "volume") == 0) return(iVolume(_Symbol, PERIOD_CURRENT, shift));
   double buf[1];
   if(StringFind(name, "rsi") == 0)   { CopyBuffer(hRSI, 0, shift, 1, buf); return(buf[0]); }
   if(StringFind(name, "atr") == 0)   { CopyBuffer(hATR, 0, shift, 1, buf); return(buf[0]); }
   if(StringFind(name, "ema") == 0)   { CopyBuffer(hMA, 0, shift, 1, buf); return(buf[0]); }
   if(StringFind(name, "sma") == 0)   { CopyBuffer(hMA, 0, shift, 1, buf); return(buf[0]); }
   if(StringFind(name, "bbpos") == 0) { CopyBuffer(hBands, 0, shift, 1, buf); return(buf[0]); }
   if(StringFind(name, "adx") == 0)   { CopyBuffer(hADX, 0, shift, 1, buf); return(buf[0]); }
   if(StringFind(name, "hour") == 0)  return((double)TimeHour(iTime(_Symbol, PERIOD_CURRENT, shift)));
   if(StringFind(name, "dow") == 0)   return((double)TimeDayOfWeek(iTime(_Symbol, PERIOD_CURRENT, shift)));
   return(0.0);
}

void OnTimer()
{
   PollLadder();
}

void PollLadder()
{
   string url = InpApiBase + "/api/v1/incubation/" + IntegerToString(InpMagic);
   char post[], result[], headers[];
   StringToCharArray("", post, 0, 0);
   string hdr = "Authorization: Bearer " + InpBotToken + "\r\n";
   StringToCharArray(hdr, headers, 0, StringLen(hdr));
   ResetLastError();
   int code = WebRequest("GET", url, hdr, 10000, post, result, headers);
   if(code != 200) return;
   string body = CharArrayToString(result);
   int p = StringFind(body, "\"multiplier\"");
   if(p >= 0) g_multiplier = StringToDouble(StringSubstr(body, p + 13, 12));
   p = StringFind(body, "\"paused\"");
   if(p >= 0) g_paused = StringFind(StringSubstr(body, p, 24), "true") >= 0;
   g_api_ok = true;
   g_lastPoll = TimeCurrent();
}

double LotsFor(double slPoints)
{
   double riskMoney = AccountInfoDouble(ACCOUNT_EQUITY) * InpRiskPercent / 100.0 * g_multiplier;
   double tickV = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickS = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double lots = tickS > 0 ? riskMoney / (slPoints * tickV / tickS) : 0.0;
   return(lots);
}

bool SessionOpen()
{
   int h = TimeHour(TimeCurrent());
   return(h >= 0 && h < 24);
}

bool SpreadTooWide() { return((int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD) > 30); }

bool DailyLossHit()
{
   double start = AccountInfoDouble(ACCOUNT_BALANCE);
   return(AccountInfoDouble(ACCOUNT_EQUITY) < start * (1.0 - InpDailyLossPct / 100.0));
}

bool SymbolLocked()
{
   if(!InpSymbolLock) return(false);
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket) && PositionGetString(POSITION_SYMBOL) == _Symbol &&
         (long)PositionGetInteger(POSITION_MAGIC) == InpMagic) return(true);
   }
   return(false);
}

bool AggRiskBreached()
{
   double risk = 0.0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket) && (long)PositionGetInteger(POSITION_MAGIC) == InpMagic)
         risk += MathAbs(PositionGetDouble(POSITION_PRICE_OPEN) - PositionGetDouble(POSITION_SL));
   }
   return(risk > InpMaxAggRiskPct);
}

void OpenTrade(int type)
{
   MqlTradeRequest req; MqlTradeResult res;
   ZeroMemory(req); ZeroMemory(res);
   double atr = V("atr21_s1");
   double slPoints = atr * 1.91;
   if(slPoints <= 0.0) return;
   req.action = TRADE_ACTION_DEAL;
   req.symbol = _Symbol;
   req.volume = LotsFor(slPoints);
   req.type = (type == 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   req.price = (type == 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
   req.sl = req.price + (type == 0 ? -1.0 : 1.0) * slPoints;
   req.tp = req.price + (type == 0 ? 1.0 : -1.0) * slPoints * 4.32;
   req.magic = InpMagic;
   req.deviation = InpSlippagePoints;
   req.type_time = ORDER_TIME_GTC;
   OrderSend(req, res);
}

void OnTick()
{
   if(!NewBar() || !g_api_ok || g_paused || !TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) return;
   if(!SessionOpen() || SpreadTooWide() || DailyLossHit() || SymbolLocked() || AggRiskBreached()) return;
   double bbpos37k1_s1 = V("bbpos37k1_s1");
   double close_s3 = V("close_s3");
   double high_s1 = V("high_s1");
   double rsi26_s1 = V("rsi26_s1");
   double rsi26_s2 = V("rsi26_s2");
   double volume_s2 = V("volume_s2");
   double volume_s3 = V("volume_s3");
   bool longSig  = (close_s3 < bbpos37k1_s1);
   bool shortSig = ((((volume_s2 < rsi26_s1) & (volume_s3 >= rsi26_s2))) & (high_s1 >= 1.073383));
   if(longSig)  OpenTrade(0);
   if(shortSig) OpenTrade(1);
}
